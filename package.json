{
  "name": "ai-web-studio",
  "repository": "https://github.com/SlovekPixel/ai-web-studio",
  "author": "Vyacheslav Gordeev",
  "keywords": [
    "ai",
    "web",
    "studio"
  ],
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "start": "turbo run start --filter=backend",
    "start:dev": "turbo run start:dev --filter=backend",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "dev:backend": "turbo run start:dev --filter=backend",
    "build:backend": "turbo run build --filter=backend",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.7.4",
    "tslib": "^2.8.1",
    "turbo": "^2.10.3",
    "typescript": "5.9.2"
  },
  "lint-staged": {
    "apps/backend/**/*.{ts,mts,cts}": [
      "eslint -c apps/backend/eslint.config.mjs --fix"
    ]
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
